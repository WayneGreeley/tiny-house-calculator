{
  "name": "tiny-house-calculator",
  "version": "1.0.0",
  "description": "A CLI and web application for managing tiny house build project costs",
  "type": "module",
  "bin": {
    "thc": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "concurrently \"npm run dev:web:server\" \"npm run dev:web:client\"",
    "dev:web:server": "tsx watch web/server/index.ts",
    "dev:web:client": "cd web/client && npm run dev",
    "build:web": "npm run build:web:server && npm run build:web:client",
    "build:web:server": "tsc -p web/server/tsconfig.json",
    "build:web:client": "cd web/client && npm run build",
    "start:web": "node dist/web/server/index.js"
  },
  "dependencies": {
    "commander": "12.1.0",
    "cors": "^2.8.5",
    "csv-stringify": "6.5.2",
    "decimal.js": "10.4.3",
    "express": "^4.18.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "22.10.2",
    "@types/uuid": "10.0.0",
    "concurrently": "^8.2.2",
    "fast-check": "3.23.2",
    "memfs": "^4.57.2",
    "tsx": "^4.7.1",
    "typescript": "5.7.2",
    "vitest": "^4.1.7"
  }
}
